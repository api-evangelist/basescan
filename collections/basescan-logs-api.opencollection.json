        {
          "info": {
            "name": "Get Event Logs by Address filtered by Topics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.basescan.org/api/?module=logs&action=getLogs&get-event-logs-by-address-filtered-by-topics",
            "params": [
              {
