              },
              {
                "name": "toBlock",
                "value": "12879196",
                "type": "query"
              },
              {
                "name": "topic",
                "value": "",
                "type": "query"
              },
              {
                "name": "topicOperator",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "1",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "1000",
                "type": "query"
              }
            ]
          },
          "docs": "Returns the events log in a block range, filtered by topics."
