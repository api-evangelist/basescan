{
  "opencollection": "1.0.0",
  "info": {
    "name": "Basescan Accounts Logs API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Logs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Event Logs by Address",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.basescan.org/api/?module=logs&action=getLogs",
            "params": [
              {
                "name": "address",
                "value": "0xbd3531da5cf5857e7cfaa92426877b022e612cf8",
                "type": "query"
              },
              {
                "name": "fromBlock",
                "value": "12878196",
                "type": "query"
              },
              {
                "name": "toBlock",
                "value": "12878196",
                "type": "query"
              },
              {
                "name": "page",
                "value": "1",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "1000",
                "type": "query"
              }
            ]
          },
          "docs": "Returns the event logs from an address, with optional filtering by block range."
        },
        {
          "info": {
            "name": "Get Event Logs by Topics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.basescan.org/api/?module=logs&action=getLogs&get-event-logs-by-topics",
