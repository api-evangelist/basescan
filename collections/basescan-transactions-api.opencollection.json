{
  "opencollection": "1.0.0",
  "info": {
    "name": "Basescan Accounts Transactions API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Transactions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Check Contract Execution Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.basescan.org/api/?module=transaction&action=getstatus",
            "params": [
              {
                "name": "txhash",
                "value": "0x15f8e5ea1079d9a0bb04a4c58ae5fe7654b5b2b4463375ff7ffb490aa0032f3a",
                "type": "query"
              }
            ]
          },
          "docs": "Returns the status code of a contract execution."
        },
        {
          "info": {
            "name": "Check Transaction Receipt Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.basescan.org/api/?module=transaction&action=gettxreceiptstatus",
            "params": [
              {
                "name": "txhash",
                "value": "0x513c1ba0bebf66436b5fed86ab668452b7805593c05073eb2d51d3a52f480a76",
                "type": "query"
              }
            ]
          },
          "docs": "Returns the status code of a transaction execution. 📝 Note: Only applicable for post Byzantium Fork transactions."
        }
      ]
    }
  ],
  "bundled": true
}